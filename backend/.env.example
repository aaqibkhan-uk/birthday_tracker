# Backend environment variables (CLAUDE.md §10).
# Copy to `.env` for local `vercel dev`; set real values in Vercel → Project → Settings → Environment Variables.
# Never commit a real `.env`.

# Which image provider to use: mock | pollinations | cloudflare
# `mock` returns 3 placeholder images instantly at zero cost. Only `mock` is implemented so far (Milestone 0).
IMAGE_PROVIDER=mock

# --- Milestone 4: real providers ---
# Pollinations (primary). Optional token for higher limits / no watermark, if the free tier offers one.
POLLINATIONS_TOKEN=

# Cloudflare Workers AI via REST (fallback).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Milestone 4: daily cap / rate limiting (Upstash Redis via Vercel Marketplace) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Global number of generation requests (rounds) allowed per day across all users.
DAILY_GENERATION_LIMIT=50
