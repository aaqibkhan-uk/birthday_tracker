# Backend environment variables (CLAUDE.md §10). See docs/image-providers.md for the provider research.
# Copy to `.env` for local `vercel dev` and the spike scripts; set real values in
# Vercel → Project → Settings → Environment Variables. Never commit a real `.env`.

# Ordered, comma-separated provider chain: primary first, then fallbacks.
# Known: mock | cloudflare | pollinations. Unset or empty means `mock` (3 instant placeholders, zero cost).
# Production: IMAGE_PROVIDERS=cloudflare (add ,pollinations once POLLINATIONS_API_KEY is set).
# Any non-mock provider needs Upstash (below); without it requests fail with 500 (fail closed).
IMAGE_PROVIDERS=mock

# Max time per provider in ms (default 40000; a Cloudflare round takes ~26 s).
PROVIDER_TIMEOUT_MS=40000
# Whole-request deadline in ms (default 55000, under the app's 60 s timeout). A fallback only gets
# the time left, and is skipped if under 5 s remain.
GENERATION_DEADLINE_MS=55000

# --- Cloudflare Workers AI (recommended primary) ---
# Free plan: 10,000 Neurons/day, resets 00:00 UTC, no card needed.
# Account ID: dashboard → Workers & Pages → right sidebar. Token: My Profile → API Tokens →
# Create Token → "Workers AI" template (Workers AI: Read + Edit).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional model override. Default @cf/black-forest-labs/flux-2-klein-4b (portrait sizes).
# Cheaper alternative: @cf/black-forest-labs/flux-1-schnell (1024x1024 square only).
CLOUDFLARE_IMAGE_MODEL=

# --- Pollinations (recommended fallback) ---
# Secret key (sk_...) from https://enter.pollinations.ai/keys. No anonymous access; billed in Pollen.
# Free "Quest Pollen" is a one-off grant (no daily refill), so keep this as a fallback only.
POLLINATIONS_API_KEY=
# Optional model override (default tongyi-mai/z-image-turbo, payable with Quest Pollen).
POLLINATIONS_MODEL=

# --- Daily cap (Upstash Redis via Vercel Marketplace) ---
# The Marketplace integration sets KV_REST_API_URL / KV_REST_API_TOKEN, which are also accepted.
# Not needed when IMAGE_PROVIDERS=mock.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Global number of generation rounds allowed per UTC day across all users (default 20). Counted
# after moderation, before providers run, so rounds that fail still count.
# 20 keeps Cloudflare inside its free daily allocation with headroom.
DAILY_GENERATION_LIMIT=20
