        <mxCell id="u8" value="notifications_prompted : INTEGER (0 | 1)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="user_profile">
          <mxGeometry y="212" width="300" height="26" as="geometry" />
        </mxCell>

        <!-- ===================== RELATIONSHIPS (crow's foot) ===================== -->
        <!-- friends 0..1 to cards 0..* (friend_id nullable so ordered cards survive friend deletion) -->
        <mxCell id="rel_friend_cards" value="has" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;startArrow=ERzeroToOne;endArrow=ERzeroToMany;startFill=0;endFill=0;rounded=0;" edge="1" parent="1" source="f1" target="c2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- cards 1 to card_designs 0..* -->
        <mxCell id="rel_card_designs" value="generates" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;rounded=0;" edge="1" parent="1" source="c1" target="d2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- cards 1 to orders 0..1 -->
        <mxCell id="rel_card_order" value="placed as" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;startArrow=ERmandOne;endArrow=ERzeroToOne;startFill=0;endFill=0;rounded=0;" edge="1" parent="1" source="c1" target="o2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===================== NOTES ===================== -->
        <mxCell id="notes" value="&lt;b&gt;Design notes (v0)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• All tables live in on-device SQLite (FR 1.4).&lt;br&gt;• Deleting a friend deletes their draft cards and designs; ordered cards keep friend_id = NULL so order history survives (FR 6.6).&lt;br&gt;• Orders snapshot recipient, address, image and text at checkout.&lt;br&gt;• Only the selected design is kept long-term; unselected rows/files can be cleaned up.&lt;br&gt;• Notifications are not stored: all are cancelled and rescheduled from friends on launch (FR 3.3.2).&lt;br&gt;• Feb 29 rule and next reminder date are computed in code, not stored.&lt;br&gt;• user_profile holds the user's own address and email for checkout (FR 6.1, 6.4)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;size=16;" vertex="1" parent="1">
          <mxGeometry x="840" y="420" width="320" height="300" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
