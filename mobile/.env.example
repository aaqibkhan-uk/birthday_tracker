# Copy to mobile/.env (git-ignored). Restart `npx expo start` after changing it.
# Backend base URL, reachable from the phone: the Mac's LAN IP with `vercel dev` (port 3000) or
# `npm run dev:mock` in backend/ (port 3001), or the deployed Vercel URL (Milestone 4).
EXPO_PUBLIC_API_URL=http://192.168.0.83:3000
